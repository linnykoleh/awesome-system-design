  "elements": [
    {
      "id": "fgSJWvUo8ePD_8mqkNqZF",
      "type": "text",
      "x": 1463.8556844175255,
      "y": -1074.9140972740079,
      "width": 655.5614073034185,
      "height": 227.90616459452377,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2F",
      "roundness": null,
      "seed": 279485829,
      "version": 673,
      "versionNonce": 331196299,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786350293719,
      "link": null,
      "locked": false,
      "text": "Functional requirements:\n    - players should be able to find an opponent \n       through matchmaking and start a game\n    - players should be able to play in realtime\n    - players should be able to view a global leaderboard\n       and see their rank\n        ",
      "fontSize": 26.046418810802717,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional requirements:\n    - players should be able to find an opponent \n       through matchmaking and start a game\n    - players should be able to play in realtime\n    - players should be able to view a global leaderboard\n       and see their rank\n        ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "K-9N4C4seI83OI6Em40vy",
      "type": "text",
      "x": 1465.8091658283356,
      "y": -783.092462769538,
      "width": 805.7707818666277,
      "height": 162.79011756751694,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2G",
      "roundness": null,
      "seed": 570831211,
      "version": 630,
      "versionNonce": 609648171,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786350293719,
      "link": null,
      "locked": false,
      "text": "Non functional requirements:\n    - low latency on more propogation (<200ms)\n    - consistency > availability for game state (pause in case of issues)\n    - scale to handle 500k concurrent games (1M connection)\n",
      "fontSize": 26.046418810802717,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non functional requirements:\n    - low latency on more propogation (<200ms)\n    - consistency > availability for game state (pause in case of issues)\n    - scale to handle 500k concurrent games (1M connection)\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "y6tRr1_Dp8eCeeVOmRfM1",
      "type": "text",
      "x": 1480.9791699091588,
      "y": -561.5452871424953,
      "width": 214.3617366840347,
      "height": 195.34814108102037,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2H",
      "roundness": null,
      "seed": 372249829,
      "version": 426,
      "versionNonce": 1692106955,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786350293719,
      "link": null,
      "locked": false,
      "text": "Core entities:\n    - Player\n    - Game\n    - Move\n    - MatchRequest\n    ",
      "fontSize": 26.046418810802717,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Core entities:\n    - Player\n    - Game\n    - Move\n    - MatchRequest\n    ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "aSldDp9tOrkhZGoMOwb1D",
      "type": "text",
      "x": 1461.079758541508,
      "y": -312.7244939526694,
      "width": 777.5104810467964,
      "height": 846.5086113510883,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2I",
      "roundness": null,
      "seed": 1193714718,
      "version": 408,
      "versionNonce": 1592209259,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786350293719,
      "link": null,
      "locked": false,
      "text": "API:\n  - players should be able to find an opponent \n       through matchmaking and start a game\n    POST /matchmaking -> MatchRequest\n    Headers: JWT\n    Body: {\n      timeControl    // e.g. \"blitz-3-2\" = 3 min each, +2s per move\n    }\n\n    - players should be able to play in realtime\n    WS /games/:gameId\n    \n    Client -> Server:\n      sendMove   { from, to, moveNumber }\n    \n    Server -> Client:\n      moveAck       { accepted, reason?, whiteTimeMs, blackTimeMs }\n      opponentMove  { from, to, whiteTimeMs, blackTimeMs }\n      gameEnd       { result }\n\n\n     - players should be able to view a global leaderboard\n       and see their rank\n    GET /leaderboard?cursor={cursor}&limit={limit} -> Player[]\n    GET /players/:playerId/rank -> { rank, rating }\n",
      "fontSize": 26.046418810802717,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "API:\n  - players should be able to find an opponent \n       through matchmaking and start a game\n    POST /matchmaking -> MatchRequest\n    Headers: JWT\n    Body: {\n      timeControl    // e.g. \"blitz-3-2\" = 3 min each, +2s per move\n    }\n\n    - players should be able to play in realtime\n    WS /games/:gameId\n    \n    Client -> Server:\n      sendMove   { from, to, moveNumber }\n    \n    Server -> Client:\n      moveAck       { accepted, reason?, whiteTimeMs, blackTimeMs }\n      opponentMove  { from, to, whiteTimeMs, blackTimeMs }\n      gameEnd       { result }\n\n\n     - players should be able to view a global leaderboard\n       and see their rank\n    GET /leaderboard?cursor={cursor}&limit={limit} -> Player[]\n    GET /players/:playerId/rank -> { rank, rating }\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
