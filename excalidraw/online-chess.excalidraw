    {
      "id": "OxHBHVm30YF1GU2PQHI3x",
      "type": "text",
      "x": 4178.197796276483,
      "y": -890.302121087602,
      "width": 762.7388916015625,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2p",
      "roundness": null,
      "seed": 779714443,
      "version": 413,
      "versionNonce": 1378400235,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786350272669,
      "link": null,
      "locked": false,
      "text": "- Redis is used as a shared, fast in-memory pool for pending matchmaking requests, \n      so every worker sees the same up-to-date set of players. \n- Workers continuously read from Redis, search for compatible opponents, \n      and atomically claim requests to prevent two workers from matching \n      the same player at the same time. \n- This keeps matchmaking fast, scalable, and safe under high concurrency.",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Redis is used as a shared, fast in-memory pool for pending matchmaking requests, \n      so every worker sees the same up-to-date set of players. \n- Workers continuously read from Redis, search for compatible opponents, \n      and atomically claim requests to prevent two workers from matching \n      the same player at the same time. \n- This keeps matchmaking fast, scalable, and safe under high concurrency.",
      "autoResize": true,
      "lineHeight": 1.25
    },
