    {
      "id": "fugsvG9MMjpP1KbfnLriO",
      "type": "text",
      "x": 13988.161857636765,
      "y": 733.6559725384539,
      "width": 746.6138371473771,
      "height": 216.86617802626193,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a0",
      "roundness": null,
      "seed": 1747552658,
      "version": 347,
      "versionNonce": 376225618,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1781079721976,
      "link": null,
      "locked": false,
      "text": "Functional requirements;\n    - Deliver alert to on-call engineer (core flow)\n    - Configure org → teams → engineers (CRUD)\n    - Configure on-call schedule (daily / weekly / monthly rotation)\n    - Configure escalation policy (delay, escalation chain)\n    - Alert history (triggered / acknowledged / resolved timestamps)\n    - Top-10 alerts per team / per company",
      "fontSize": 24.78470606014422,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional requirements;\n    - Deliver alert to on-call engineer (core flow)\n    - Configure org → teams → engineers (CRUD)\n    - Configure on-call schedule (daily / weekly / monthly rotation)\n    - Configure escalation policy (delay, escalation chain)\n    - Alert history (triggered / acknowledged / resolved timestamps)\n    - Top-10 alerts per team / per company",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "6CeGv2bnkRAerrnzx8fTo",
      "type": "text",
      "x": 13996.53032650424,
      "y": 1016.9616213997704,
      "width": 618.9478865739102,
      "height": 154.9044128759014,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a1",
      "roundness": null,
      "seed": 35307086,
      "version": 391,
      "versionNonce": 1157432594,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1781079721976,
      "link": null,
      "locked": false,
      "text": "Non functional requirements:\n    - availability - eventual consistency\n    - latency - < 10–15 s\n    - scale - 1 M+ services globally; 10–100 M alerts/day\n    - durability - no alert loss - at-least-once delivery",
      "fontSize": 24.78470606014422,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non functional requirements:\n    - availability - eventual consistency\n    - latency - < 10–15 s\n    - scale - 1 M+ services globally; 10–100 M alerts/day\n    - durability - no alert loss - at-least-once delivery",
      "autoResize": true,
      "lineHeight": 1.25
    },
