    {
      "id": "k9i1qn9S3bDbp2gX",
      "type": "text",
      "x": 1344.0445492242432,
      "y": 1762.8353515226627,
      "width": 566,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 239556469,
      "version": 503,
      "versionNonce": 1577999399,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794137326534,
      "link": null,
      "locked": false,
      "text": "Lesson lifecycle (follow-up):\n   - booked -> room created; join tokens at T-5m: per role, TTL 2h, room = bookingId\n   - started: both joined (presence webhooks from RTC) -> lesson.started\n   - ended -> auto-confirm after 15 min if no dispute -> tutor payout\n   - no-show: one side absent 15 min -> cancel + refund policy\n   - resilience: audio-only fallback, reconnect with same token, region-aware edge\n   - security: short-lived tokens, room per booking, signed webhooks, recording by consent\n   NOT streaming: real-time conferencing (<300 ms), WebRTC over UDP, no CDN / HLS\n   buy vs build: 100k lessons/day x 50 min x 2 = ~10M participant-min/day\n   -> global RTC network bought (quality = product); self-hosted SFU only when $/min hurts",
      "originalText": "Lesson lifecycle (follow-up):\n   - booked -> room created; join tokens at T-5m: per role, TTL 2h, room = bookingId\n   - started: both joined (presence webhooks from RTC) -> lesson.started\n   - ended -> auto-confirm after 15 min if no dispute -> tutor payout\n   - no-show: one side absent 15 min -> cancel + refund policy\n   - resilience: audio-only fallback, reconnect with same token, region-aware edge\n   - security: short-lived tokens, room per booking, signed webhooks, recording by consent\n   NOT streaming: real-time conferencing (<300 ms), WebRTC over UDP, no CDN / HLS\n   buy vs build: 100k lessons/day x 50 min x 2 = ~10M participant-min/day\n   -> global RTC network bought (quality = product); self-hosted SFU only when $/min hurts",
      "fontSize": 14,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b0i",
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
