      "seed": 974364242,
      "version": 2,
      "versionNonce": 1015829037,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793956083197,
      "link": null,
      "locked": false,
      "text": "Search flow:\n   1. filters -> ES candidates (top-200)\n   2. ML score: offline batch (nightly) -> Redis\n      + online features (goals, budget, tz overlap)\n   3. business rules: new-tutor boost, diversity\n   4. fallback: static_score if ranking is down\n   5. A/B: bucket(learnerId) -> model variant, log exposure",
      "originalText": "Search flow:\n   1. filters -> ES candidates (top-200)\n   2. ML score: offline batch (nightly) -> Redis\n      + online features (goals, budget, tz overlap)\n   3. business rules: new-tutor boost, diversity\n   4. fallback: static_score if ranking is down\n   5. A/B: bucket(learnerId) -> model variant, log exposure",
      "fontSize": 14,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b0k",
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "3Q4UCxIBBXUBYocD",
      "type": "text",
      "x": 1424.0805772176323,
      "y": 1296.4651873320852,
      "width": 411.4315185546875,
      "height": 245,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
