    {
      "id": "1cpTdFlg5Heh0bfE",
      "type": "text",
      "x": -608.4241160892288,
      "y": -81.94526552287851,
      "width": 783.9232788085938,
      "height": 160.2202766983978,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
