    {
      "id": "gvfl82jjYcw5-Poh",
      "type": "text",
      "x": 2000,
      "y": 440,
      "width": 361,
      "height": 122,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
